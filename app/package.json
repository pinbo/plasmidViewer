{
  "name": "plasmid-viewer",
  "productName": "Plasmid Viewer",
  "version": "1.0.0",
  "description": "View, edit and save plasmid maps",
  "main": "main.js",
  "author": "Plasmid Viewer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "node fix-electron.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "org.plasmidviewer.app",
    "productName": "Plasmid Viewer",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "build/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "gb",
          "gbk",
          "gbff"
        ],
        "name": "GenBank file",
        "role": "Editor"
      },
      {
        "ext": [
          "fa",
          "fasta",
          "fna"
        ],
        "name": "FASTA file",
        "role": "Editor"
      },
      {
        "ext": [
          "dna"
        ],
        "name": "SnapGene file",
        "role": "Viewer"
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "icon": "build/icon.png"
    },
    "directories": {
      "buildResources": "build"
    },
    "icon": "build/icon.png"
  }
}
